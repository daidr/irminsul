# Docker Compose maps the app to 127.0.0.1 on this port.
IRMIN_HTTP_PORT=3000

# Used for manual deployment; Compose overrides these URLs with service names.
IRMIN_DB_URL=mongodb://127.0.0.1:27017
IRMIN_DB_NAME=irmin
IRMIN_REDIS_URL=redis://127.0.0.1:6379
IRMIN_REDIS_SCOPE=irmin

HOST=127.0.0.1
PORT=3000
IRMIN_PUBLIC_SITE_NAME=Irminsul
# Public site origin, without a trailing slash or /api/yggdrasil suffix.
IRMIN_YGGDRASIL_BASE_URL=https://auth.example.com
IRMIN_YGGDRASIL_SKIN_DOMAINS=auth.example.com
IRMIN_WEBAUTHN_RP_ID=auth.example.com
IRMIN_WEBAUTHN_ORIGIN=https://auth.example.com
# Enable only when access is restricted to a trusted reverse proxy.
IRMIN_TRUST_PROXY=false

# Required when migrating GHAuth accounts that use the old global salt.
IRMIN_LEGACY_GLOBAL_SALT=
