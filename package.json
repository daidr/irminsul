{
  "name": "irminsul-nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "prod": "nuxt build && bun .output/server/index.mjs",
    "lint": "oxlint --type-aware --type-check --format=stylish",
    "lint:fix": "oxlint --type-aware --type-check --fix --format=stylish",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "test": "vitest run",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@daidr/minecraft-skin-renderer": "^0.3.2",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/vue": "^1.0.8",
    "@napi-rs/canvas": "^0.1.100",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "4.2.0",
    "@pinia/nuxt": "^1.0.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.3.3",
    "@vueuse/core": "^14.4.0",
    "altcha": "^3.2.2",
    "daisyui": "5.7.28",
    "evlog": "^2.28.1",
    "isomorphic-dompurify": "^3.23.0",
    "js-sha3": "^0.13.0",
    "marked": "^18.0.11",
    "mongodb": "7.5.0",
    "motion-v": "^2.4.1",
    "nodemailer": "^8.0.11",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "pngjs-nozlib": "^1.0.0",
    "sortablejs": "^1.15.7",
    "uuid": "^13.0.2",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/sortablejs": "^1.15.9",
    "@types/uuid": "^11.0.0",
    "bun-git-hooks": "^0.3.3",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sass-embedded": "^1.104.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "8.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "bun run lint"
  }
}
